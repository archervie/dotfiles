// ────────────── Layout Configuration ──────────────

    layout {
        gaps 16
    	center-focused-column "never"

    	background-color "transparent"

    	tab-indicator {
    		on
    		hide-when-single-tab
    	}

    	preset-column-widths {
    		proportion 0.5
    	}

    	default-column-width {
    		proportion 0.5
    	}

    	focus-ring {
    		width 4
    		active-color "acacac"
    		urgent-color "cc4444"
    	}

    	struts {
    	}
    }
