// ────────────── Input Configuration ──────────────

    input {
    	keyboard {
    		xkb {
    			layout "us"
    		}

    		// Disables numlock.
    		numlock
    	}

    	mouse {
        	// off
        	// natural-scroll
        	// accel-speed 0.2
        	// accel-profile "flat"
        	// scroll-method "no-scroll"
    	}

    	touchpad {
        	// off
        	tap
        	// dwt
        	// dwtp
        	// drag false
        	// drag-lock
        	natural-scroll
        	// accel-speed 0.2
        	// accel-profile "flat"
        	// scroll-method "two-finger"
        	// disabled-on-external-mouse
    	}

    	trackpoint {
        	off
        	// natural-scroll
        	// accel-speed 0.2
        	// accel-profile "flat"
        	// scroll-method "on-button-down"
        	// scroll-button 273
        	// scroll-button-lock
        	// middle-emulation
    	}

        workspace-auto-back-and-forth
    }
